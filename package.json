{
  "name": "doc-mason-api",
  "version": "1.0.0",
  "description": "Official API client for https://docmason.co - PDF generation and template management service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test-package": "ts-node test-package.ts",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "doc-mason",
    "pdf",
    "template",
    "api",
    "client",
    "typescript"
  ],
  "author": "Doc Mason ike@getdocmason.com (https://docmason.co)",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "node-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmason-dot-co/docmason-api.git"
  },
  "bugs": {
    "url": "https://github.com/docmason-dot-co/docmason-api/issues"
  },
  "homepage": "https://github.com/docmason-dot-co/docmason-api#readme"
